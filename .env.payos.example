# ================================
# PAYOS CONFIGURATION
# ================================
# Lấy thông tin từ PayOS Dashboard: https://my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Webhook URL (Production hoặc ngrok cho dev)
# Production: https://yourdomain.com/payments/webhook/payos
# Dev: https://abc123.ngrok.io/payments/webhook/payos
PAYOS_WEBHOOK_URL=

# ================================
# BUSINESS CONFIGURATION
# ================================
# Email admin nhận thông báo khi có đơn thanh toán mới
BUSINESS_ADMIN_EMAIL=admin@example.com
